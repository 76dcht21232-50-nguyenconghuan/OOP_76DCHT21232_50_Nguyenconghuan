#include <iostream>
#include <string>
#include <iomanip>

using namespace std;

class SinhVien
{
private:
    string hoTen;
    int namSinh;
    float diem[5];

public:
    void nhap()
    {
        cout << "Nhap ho ten: ";
        getline(cin, hoTen);

        cout << "Nhap nam sinh: ";
        cin >> namSinh;

        for(int i = 0; i < 5; i++)
        {
            cout << "Nhap diem mon " << i + 1 << ": ";
            cin >> diem[i];
        }

        cin.ignore();
    }

    void xuat()
    {
        cout << "Ho ten: " << hoTen << endl;
        cout << "Nam sinh: " << namSinh << endl;

        cout << "Diem 5 mon: ";
        for(int i = 0; i < 5; i++)
        {
            cout << diem[i] << " ";
        }
        cout << endl;

        cout << "Diem trung binh: " << fixed << setprecision(2)
             << tinhDiemTB() << endl;
    }

    float tinhDiemTB()
    {
        float tong = 0;

        for(int i = 0; i < 5; i++)
        {
            tong = tong + diem[i];
        }

        return tong / 5;
    }

    void thiLai()
    {
        string tenMon[5] = {
            "Toan",
            "Ly",
            "Hoa",
            "Tin",
            "Tieng Anh"
        };

        bool coThiLai = false;

        for(int i = 0; i < 5; i++)
        {
            if(diem[i] < 5)
            {
                if(coThiLai == false)
                {
                    cout << "\nCac mon phai thi lai:" << endl;
                    coThiLai = true;
                }

                cout << tenMon[i] << " - Diem: " << diem[i] << endl;
            }
        }

        if(coThiLai == false)
        {
            cout << "Sinh vien khong co mon phai thi lai." << endl;
        }
    }
};

int main()
{
    int n;

    cout << "Nhap so luong sinh vien: ";
    cin >> n;
    cin.ignore();

    SinhVien sv[100];

    // Nhap n sinh vien
    for(int i = 0; i < n; i++)
    {
        cout << "\n========== SINH VIEN " << i + 1 << " ==========" << endl;
        sv[i].nhap();
    }

    cout << "\n\n========== DANH SACH SINH VIEN ==========" << endl;

    for(int i = 0; i < n; i++)
    {
        cout << "\n--- Sinh vien " << i + 1 << " ---" << endl;
        sv[i].xuat();
    }

    cout << "\n\n========== SINH VIEN PHAI THI LAI ==========" << endl;

    for(int i = 0; i < n; i++)
    {
        cout << "\nSinh vien: " << i + 1 << endl;
        sv[i].thiLai();
    }

    return 0;
}
